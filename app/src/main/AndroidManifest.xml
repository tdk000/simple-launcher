<?xml version="1.0" encoding="utf-8"?>
<!--
  Версии и SDK здесь НАМЕРЕННО не написаны: их выставляет сборка
  (build.sh: flavor legacy -> min 21 / target 23, modern -> min 21 / target 37;
  либо app/build.gradle для Android Studio). Один исходник — два APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.simplelauncher">

    <!-- С targetSdk 28+ без него меню «Удалить» (Intent.ACTION_DELETE) не работает:
         система требует REQUEST_DELETE_PACKAGES. Разрешение normal, выдаётся при
         установке, на старых устройствах и старых target'ах просто не используется. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Видимость пакетов (targetSdk 30+): без этого блока queryIntentActivities()
         на Android 11+ вернёт пустоту, и сетка лаунчера будет пустой.
         Intent-фильтр открывает видимость ВСЕМ пакетам, у которых есть
         запускаемая activity — ровно то, что показывает лаунчер. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="nosensor"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
